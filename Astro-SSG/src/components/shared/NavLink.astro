---
import type { NavLink } from '@interfaces/NavBar';

interface Props {
    navLinks: NavLink[];
}

const { navLinks } = Astro.props as Props;

// Respeta el `base` configurado en astro.config (p. ej. /taller-4-astro-angular-ssg-spa/)
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const trimSlash = (path: string) => path.replace(/\/$/, '');
const pathname = trimSlash(Astro.url.pathname);
---

<ul class="nav nav-pills">
    {navLinks.map((navLink) => (
        <li class="nav-item">
            <a  href={`${base}${navLink.url}`}
                class={`nav-link ${pathname === trimSlash(`${base}${navLink.url}`) ? "active" : ""}`}>
                {navLink.text}
            </a>
        </li>
    ))}
</ul>
